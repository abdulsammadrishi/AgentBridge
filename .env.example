# Local development defaults
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
AGENTBRIDGE_DATA_DIR=server/data
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8091,http://localhost:8092
DEMO_RESET_ENABLED=true

