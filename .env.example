# Local development defaults
PORT=3000
# Optional. The server defaults to 0.0.0.0, which is required by Railway and other hosts.
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
AGENTBRIDGE_DATA_DIR=server/data
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8091,http://localhost:8092
DEMO_RESET_ENABLED=true
AUTO_SEED_DEMO=false

# Deploy these on your host. Do not invent or commit an origin-trial token.
# PUBLIC_BASE_URL=https://your-agentbridge-domain.example
# API_BASE_URL=https://your-agentbridge-domain.example
# CORS_ORIGINS=https://your-agentbridge-domain.example
# HOST=0.0.0.0
# DEMO_RESET_ENABLED=false
# AUTO_SEED_DEMO=true
# WEBMCP_ORIGIN_TRIAL_TOKEN=
